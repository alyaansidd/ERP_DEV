{
  "info": {
    "name": "ERP RBAC Tests",
    "description": "Full Role-Based Access Control test suite.\n\nRoles: admin, faculty, student\n\nRun order:\n1. Setup > Login Admin\n2. Setup > Register Faculty / Student\n3. Setup > Login Faculty / Student\n4. Run any test folder",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 — Setup",
      "description": "Run these first, top-to-bottom, to create users and collect tokens.",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.environment.set('admin_token', res.accessToken);",
                  "  pm.test('Admin token saved', () => pm.expect(res.success).to.be.true);",
                  "} else {",
                  "  pm.test('Login failed — seed admin first', () => pm.expect.fail(res.message));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Register Faculty (admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Faculty created', () => pm.expect(res.user.role).to.eql('faculty'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Faculty User\",\n  \"email\": \"{{faculty_email}}\",\n  \"password\": \"{{faculty_password}}\",\n  \"role\": \"faculty\",\n  \"phoneNo\": \"8888888888\",\n  \"aadharNo\": \"888888888888\",\n  \"dob\": \"1985-06-15\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Register Student (admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Student created', () => pm.expect(res.user.role).to.eql('student'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student User\",\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{student_password}}\",\n  \"role\": \"student\",\n  \"phoneNo\": \"7777777777\",\n  \"aadharNo\": \"777777777777\",\n  \"dob\": \"2000-03-20\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login Faculty",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.environment.set('faculty_token', res.accessToken);",
                  "pm.test('Faculty token saved', () => pm.expect(res.success).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{faculty_email}}\",\n  \"password\": \"{{faculty_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.environment.set('student_token', res.accessToken);",
